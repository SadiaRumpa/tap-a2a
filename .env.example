# TAP-A2A — environment template.
#
# Copy to .env and fill in. .env is gitignored; THIS file is committed, so
# it must never contain a real key.
#
#     cp .env.example .env
#
# Planning falls back to the deterministic keyword planner when no backend
# is configured, and says so at run time.

# Backend: ollama | openai | anthropic | none
TAP_A2A_LLM=openai

# Optional model override. Defaults: llama3.2 / gpt-4o-mini / claude-sonnet-4-6
# TAP_A2A_LLM_MODEL=gpt-4o-mini

# Credentials — only the one matching TAP_A2A_LLM is needed.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Commitment level for on-chain benchmarks: confirmed (default) | finalized
# TAP_A2A_COMMITMENT=confirmed
